          "name": "Get national generation mix for a date/time range",
          "request": {
            "name": "Get national generation mix for a date/time range",
            "description": {
              "content": "Returns national electricity generation mix data for all half-hour periods between the specified from and to datetimes. This is a beta endpoint.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "generation",
                ":from",
                ":to"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<dateTime>",
                  "key": "from",
                  "description": "(Required) Start datetime in ISO 8601 format (YYYY-MM-DDThh:mmZ). Example: 2018-01-20T12:00Z"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<dateTime>",
                  "key": "to",
                  "description": "(Required) End datetime in ISO 8601 format (YYYY-MM-DDThh:mmZ). Example: 2018-01-20T12:30Z"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
